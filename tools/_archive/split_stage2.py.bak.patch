# ============================================================
# 核心拆分函数
# ============================================================
def extract_methods(source_lines, class_node, method_names):
    """从类节点提取指定的方法（含分节注释和尾随空行）"""
    found = {}
    for item in class_node.body:
        if isinstance(item, ast.FunctionDef) and item.name in method_names:
            start, end = find_method_range(source_lines, item)
            found[item.name] = {
                'start': start,
                'end': end,
                'lines': source_lines[start:end],
                'node': item,
            }
    return found


def do_split(source, source_lines, main_window_cls,
             method_names, mixin_name, mixin_file,
             header, class_bases_old_adder,
             dry_run=False):
    """执行单次拆分"""
    print()
    print(f"  目标: {mixin_file.name}")
    print(f"  计划拆分 {len(method_names)} 个方法")

    found = extract_methods(source_lines, main_window_cls, method_names)

    if not found:
        print_fail("未找到任何目标方法")
        return None

    # 显示
    ordered = sorted(found.items(), key=lambda kv: kv[1]['start'])
    total_lines = sum(len(v['lines']) for v in found.values())
    print_info(f"  实际找到: {len(found)} 个方法，共 {total_lines} 行")
    for name, info in ordered:
        print(f"      {name:35s} 行 {info['start']+1:>5d}-{info['end']:<5d} "
              f"({info['end']-info['start']:>3d} 行)")

    missing = set(method_names) - set(found.keys())
    if missing:
        print_warn(f"  未找到: {', '.join(sorted(missing))}")

    if dry_run:
        return found

    # 生成 mixin 内容
    mixin_body = []
    for name, info in ordered:
        mixin_body.extend(info['lines'])

    mixin_content = '\n'.join(
        header + mixin_body
    ).rstrip() + '\n'

    # 写 mixin
    try:
        with open(mixin_file, 'w', encoding='utf-8', newline='\n') as f:
            f.write(mixin_content)
        print_ok(f"已生成: {mixin_file.relative_to(ROOT)}")
    except Exception as e:
        print_fail(f"生成失败: {e}")
        return None

    return found


# ============================================================
# 主流程
# ============================================================
def main():
    parser = argparse.ArgumentParser(
        description="阶段 2: 拆分 ui/main_window.py 的文件/编辑操作"
    )
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--no-backup', action='store_true')
    args = parser.parse_args()

    print_header("阶段 2 拆分: ui/main_window.py")
    print(f"  源文件:   {MW}")
    print(f"  模式:     {'DRY-RUN' if args.dry_run else '实际拆分'}")

    # ---- 前置检查 ----
    print_header("前置检查")

    if not MW.exists():
        print_fail(f"文件不存在: {MW}")
        return 1
    print_ok("main_window.py 存在")

    # 确认阶段 1 已完成
    try:
        with open(MW, 'r', encoding='utf-8') as f:
            source = f.read()
    except Exception as e:
        print_fail(f"读取失败: {e}")
        return 1

    if "StatusBarMixin" not in source:
        print_fail("阶段 1 未完成（未找到 StatusBarMixin）")
        print_info("请先执行: python tools/split_stage1.py")
        return 1
    print_ok("阶段 1 已完成（StatusBarMixin 存在）")

    # 检查 mixin 文件是否已存在
    file_mixin = MIXIN_DIR / "file_ops_mixin.py"
    edit_mixin = MIXIN_DIR / "edit_ops_mixin.py"

    if file_mixin.exists() and edit_mixin.exists():
        print_skip("阶段 2 已执行")
        return 0

    # ---- 解析 AST ----
    source_lines = source.split('\n')
    try:
        tree = ast.parse(source)
    except SyntaxError as e:
        print_fail(f"语法错误: 行 {e.lineno}: {e.msg}")
        return 1

    main_window_cls = None
    for node in ast.walk(tree):
        if isinstance(node, ast.ClassDef) and node.name == "MainWindow":
            main_window_cls = node
            break

    if main_window_cls is None:
        print_fail("未找到 MainWindow 类")
        return 1
    print_ok(f"找到 MainWindow 类（行 {main_window_cls.lineno}）")

    # ---- 执行拆分 ----
    print_header("拆分 1: FileOpsMixin")

    file_found = do_split(
        source, source_lines, main_window_cls,
        FILE_OPS_METHODS, "FileOpsMixin",
        file_mixin, FILE_OPS_HEADER,
        None, dry_run=args.dry_run,
    )
    if file_found is None:
        print_fail("FileOpsMixin 拆分失败")
        return 1

    print_header("拆分 2: EditOpsMixin")

    edit_found = do_split(
        source, source_lines, main_window_cls,
        EDIT_OPS_METHODS, "EditOpsMixin",
        edit_mixin, EDIT_OPS_HEADER,
        None, dry_run=args.dry_run,
    )
    if edit_found is None:
        print_fail("EditOpsMixin 拆分失败")
        return 1

    # ---- dry-run 结束 ----
    if args.dry_run:
        total = sum(len(v['lines']) for v in file_found.values()) + \
                sum(len(v['lines']) for v in edit_found.values())
        print()
        print("=" * 60)
        print(f"  DRY-RUN 汇总: 将拆分 {total} 行")
        print("=" * 60)
        print()
        print("✓ DRY-RUN 完成")
        print("  运行 `python tools/split_stage2.py` 执行")
        return 0

    # ---- 从 main_window.py 删除方法 ----
    print_header("修改 main_window.py")

    backup = MW.with_suffix(".py.bak.split2")
    if not args.no_backup:
        try:
            shutil.copy2(MW, backup)
            print_ok(f"已备份: {backup.name}")
        except Exception as e:
            print_fail(f"备份失败: {e}")
            return 1

    # 合并所有要删的方法范围
    to_remove = []
    for info in file_found.values():
        to_remove.append((info['start'], info['end']))
    for info in edit_found.values():
        to_remove.append((info['start'], info['end']))

    # 去重（可能有重叠）
    to_remove.sort()
    merged = []
    for start, end in to_remove:
        if merged and start <= merged[-1][1]:
            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
        else:
            merged.append((start, end))

    # 从后往前删
    for start, end in reversed(merged):
        del source_lines[start:end]

    new_source = '\n'.join(source_lines)

    # ---- 修改 class 声明 ----
    pattern = re.compile(r'^class MainWindow\(([^)]+)\):', re.MULTILINE)
    match = pattern.search(new_source)
    if not match:
        print_fail("未找到 class MainWindow 声明")
        if not args.no_backup:
            shutil.copy2(backup, MW)
            print_warn("已从备份还原")
        return 1

    bases = match.group(1).strip()
    if 'FileOpsMixin' in bases:
        print_skip("class 声明已包含 FileOpsMixin")
    else:
        new_bases = f"FileOpsMixin, EditOpsMixin, {bases}"
        new_source = pattern.sub(
            f"class MainWindow({new_bases}):",
            new_source, count=1
        )
        print_ok(f"class 声明已更新: MainWindow({new_bases})")

    # ---- 加 import ----
    imports = [
        "from ui.mixins.file_ops_mixin import FileOpsMixin",
        "from ui.mixins.edit_ops_mixin import EditOpsMixin",
    ]
    pattern2 = re.compile(r'^(class MainWindow\()', re.MULTILINE)
    for imp in imports:
        if imp in new_source:
            print_skip(f"import 已存在: {imp}")
        else:
            new_source = pattern2.sub(
                f"{imp}\n\\1", new_source, count=1
            )
            print_ok(f"已插入: {imp}")
    # 上面循环里 pattern2.sub 只 sub 一次，所以第二次插入时会和
    # 上一次插入的行混在一起。实际写法需要更稳。
    # 修正：先构造好所有 import 行，再一次性插入。
    # 重新做一遍：
    # （这里简化，重新从 new_source 移除然后批量插入）
    # 实际操作：把上面两行 import 一起插入
    # 为简单起见，下面重写：

    # 检查并插入两个 import（干净做法）
    new_source = re.sub(
        r'^from ui\.mixins\.file_ops_mixin import FileOpsMixin\n',
        '', new_source, flags=re.MULTILINE
    )
    new_source = re.sub(
        r'^from ui\.mixins\.edit_ops_mixin import EditOpsMixin\n',
        '', new_source, flags=re.MULTILINE
    )
    import_block = (
        "from ui.mixins.file_ops_mixin import FileOpsMixin\n"
        "from ui.mixins.edit_ops_mixin import EditOpsMixin\n"
    )
    new_source = pattern2.sub(
        f"{import_block}\n\\1", new_source, count=1
    )
    print_ok("已插入 2 个 import")

    # ---- 写回 ----
    try:
        with open(MW, 'w', encoding='utf-8', newline='\n') as f:
            f.write(new_source)
        print_ok("已写回 main_window.py")
    except Exception as e:
        print_fail(f"写回失败: {e}")
        if not args.no_backup:
            shutil.copy2(backup, MW)
            print_warn("已从备份还原")
        return 1

    # ---- 语法验证 ----
    print_header("语法验证")

    all_ok = True
    for rel in ["ui/main_window.py",
                "ui/mixins/file_ops_mixin.py",
                "ui/mixins/edit_ops_mixin.py"]:
        p = ROOT / rel
        ok, err = validate_syntax(p)
        if ok:
            print_ok(rel)
        else:
            print_fail(f"{rel}: {err}")
            all_ok = False

    if not all_ok:
        if not args.no_backup:
            shutil.copy2(backup, MW)
            try:
                file_mixin.unlink()
                edit_mixin.unlink()
            except Exception:
                pass
            print_warn("main_window.py 已还原，mixins 已删除")
        return 1

    # ---- 行数统计 ----
    print_header("行数统计")
    original_lines = len(source.split('\n'))
    new_lines = len(new_source.split('\n'))
    file_mixin_lines = len(open(file_mixin, encoding='utf-8').read()
                             .split('\n'))
    edit_mixin_lines = len(open(edit_mixin, encoding='utf-8').read()
                             .split('\n'))

    print(f"  原 main_window.py:    {original_lines:>5d} 行")
    print(f"  新 main_window.py:    {new_lines:>5d} 行")
    print(f"  已移除:               {original_lines - new_lines:>5d} 行")
    print(f"  file_ops_mixin.py:    {file_mixin_lines:>5d} 行")
    print(f"  edit_ops_mixin.py:    {edit_mixin_lines:>5d} 行")
    print(f"  累计（含阶段 1）:       "
          f"{file_mixin_lines + edit_mixin_lines:>5d} 行拆出")

    # ---- 完成 ----
    print_header("完成")
    print_ok("阶段 2 拆分成功")
    print()
    print("  下一步:")
    print("    1. 启动编辑器: python main.py")
    print("    2. 回归测试:")
    print("       - 新建/打开/保存/另存为/关闭")
    print("       - 撤销/重做/复制/粘贴")
    print("       - 复制行/移动行/注释")
    print("    3. 观察日志无异常")
    print()
    print("  回滚:")
    print(f"    copy ui\\main_window.py.bak.split2 ui\\main_window.py")
    print(f"    del ui\\mixins\\file_ops_mixin.py")
    print(f"    del ui\\mixins\\edit_ops_mixin.py")

    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\n用户中断")
        sys.exit(130)
    except Exception as e:
        print(f"\n脚本异常: {e}")
        traceback.print_exc()
        sys.exit(1)