# ============================================================
# 通用工具
# ============================================================
def print_header(t):
    print()
    print("=" * 60)
    print(t)
    print("=" * 60)


def print_ok(m):
    print("  [OK]   " + m)


def print_skip(m):
    print("  [SKIP] " + m)


def print_warn(m):
    print("  [WARN] " + m)


def print_fail(m):
    print("  [FAIL] " + m)


def print_info(m):
    print("  [INFO] " + m)


def validate_syntax(path):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            src = f.read()
        compile(src, str(path), 'exec')
        return True, ""
    except SyntaxError as e:
        return False, f"line {e.lineno}: {e.msg}"
    except Exception as e:
        return False, str(e)


def find_method_range(source_lines, node):
    """找方法的完整行范围 [start, end)"""
    start = node.lineno - 1

    if node.decorator_list:
        start = min(d.lineno for d in node.decorator_list) - 1

    # 前置分节注释
    i = start - 1
    while i >= 0 and source_lines[i].strip().startswith('#'):
        i -= 1
    if i + 1 < start:
        first_comment = source_lines[i + 1].strip()
        if (first_comment.startswith('# ===') or
                first_comment.startswith('# ---')):
            start = i + 1

    end = node.end_lineno if hasattr(node, 'end_lineno') else node.lineno

    # 吞空行
    while end < len(source_lines) and source_lines[end].strip() == '':
        end += 1

    return start, end


