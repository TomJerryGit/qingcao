    "python",
    "debug",
    "bdb",
    "breakpoint"
  ],
  "permissions": [
    "process",
    "editor_read",
    "editor_write",
    "dialog"
  ],
  "dependencies": [],
  "api_version": "2.0.0",
  "enabled": true,
  "auto_load": true,
  "load_order": 100
}
