# -*- coding: utf-8 -*-
"""Disable Minimap to avoid SCI_SETDOCPOINTER crash."""
import os
import re
import sys
import shutil

ROOT = os.path.dirname(os.path.abspath(__file__))

# ------------------------------------------------------------
# 1. Patch ui/minimap.py: disable set_editor body
# ------------------------------------------------------------
MINIMAP_PATH = os.path.join(ROOT, 'ui', 'minimap.py')

NEW_SET_EDITOR = '''    def set_editor(self, editor):
        """
        Set main editor. Document pointer sharing is DISABLED
        because SCI_SETDOCPOINTER causes access violation on
        PyQt5 + QScintilla. We only copy the text safely.
        """
        try:
            if editor is None:
                self.clear()
                self.main_editor = None
                return

            self.main_editor = editor

            # Safe: copy text only (no shared pointer)
            try:
                text = editor.text()
                self.setText(text)
            except Exception as e:
                print("[Minimap] copy text failed: %s" % e)

        except Exception as e:
            print("[Minimap] set_editor failed: %s" % e)
'''

with open(MINIMAP_PATH, 'r', encoding='utf-8') as f:
    content = f.read()

# Find the whole set_editor method (up to next def at same indent)
pattern = re.compile(
    r'(?P<indent>[ \t]*)def\s+set_editor\s*\(\s*self\s*,\s*editor.*?\)\s*:.*?'
    r'(?=\n(?P=indent)def\s)',
    re.DOTALL
)

m = pattern.search(content)
if m:
    indent = m.group('indent')
    # Reindent NEW_SET_EDITOR body
    lines = NEW_SET_EDITOR.split('\n')
    reindented = []
    for line in lines:
        if line.startswith('    '):
            reindented.append(indent + line[4:])
        elif line.strip() == '':
            reindented.append('')
        else:
            reindented.append(indent + line)
    new_body = '\n'.join(reindented)

    new_content = content[:m.start()] + new_body + content[m.end():]

    # Backup
    shutil.copy2(MINIMAP_PATH, MINIMAP_PATH + '.bak')
    with open(MINIMAP_PATH, 'w', encoding='utf-8') as f:
        f.write(new_content)
    print("[OK] ui/minimap.py set_editor neutralized")
else:
    print("[WARN] set_editor not found in minimap.py")


# ------------------------------------------------------------
# 2. Patch ui/main_window.py: skip Minimap loading
# ------------------------------------------------------------
MW_PATH = os.path.join(ROOT, 'ui', 'main_window.py')

with open(MW_PATH, 'r', encoding='utf-8') as f:
    content = f.read()

# Look for the Minimap loading block
if '# ==== Minimap (DISABLED to avoid crash) ====' not in content:
    # Replace the try: from ui.minimap import Minimap ... block
    pattern2 = re.compile(
        r'(# ============ Minimap.*?\n)'
        r'(\s*try:.*?self\.minimap_dock = None\n)',
        re.DOTALL
    )
    m2 = pattern2.search(content)
    if m2:
        replacement = (
            '# ============ Minimap (DISABLED to avoid crash) ============\n'
            '        self.minimap = None\n'
            '        self.minimap_dock = None\n'
        )
        new_content = content[:m2.start()] + replacement + content[m2.end():]
        shutil.copy2(MW_PATH, MW_PATH + '.bak')
        with open(MW_PATH, 'w', encoding='utf-8') as f:
            f.write(new_content)
        print("[OK] ui/main_window.py Minimap loading disabled")
    else:
        print("[WARN] Minimap loading block not found in main_window.py")
else:
    print("[SKIP] main_window.py already patched")


print()
print("Done. Now run:")
print("  python -u main.py --no-splash")