{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "运行 Python",
      "command": "python",
      "args": ["${file}"],
      "group": "run"
    },
    {
      "label": "编译当前文件",
      "command": "python",
      "args": ["-m", "py_compile", "${file}"],
      "group": "build"
    },
    {
      "label": "运行测试",
      "command": "python",
      "args": ["-m", "pytest", "tests/"],
      "group": "test"
    },
    {
      "label": "格式化代码",
      "command": "python",
      "args": ["-m", "black", "."],
      "group": "format"
    }
  ]
}