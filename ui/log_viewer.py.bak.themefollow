# -*- coding: utf-8 -*-
"""日志查看器"""
import os
from PyQt5.QtWidgets import (
    QDialog, QVBoxLayout, QHBoxLayout, QPlainTextEdit, QPushButton,
    QComboBox, QLineEdit, QLabel, QFileDialog, QMessageBox,
    QApplication
)
from PyQt5.QtCore import Qt
from PyQt5.QtGui import QFont


class LogViewer(QDialog):
    """日志查看器"""

    def __init__(self, log_path="", parent=None):
        super().__init__(parent)
        self.setWindowTitle("日志查看器")
        self.resize(900, 600)

        self.log_path = log_path
        self._all_lines = []

        self._build_ui()
        self._apply_style()
        self._load_log()

    def _build_ui(self):
        layout = QVBoxLayout(self)

        # 工具栏
        top = QHBoxLayout()

        top.addWidget(QLabel("日志文件:"))
        self.path_edit = QLineEdit(self.log_path)
        self.path_edit.setReadOnly(True)
        top.addWidget(self.path_edit, 1)

        browse_btn = QPushButton("浏览...")
        browse_btn.clicked.connect(self._browse)
        top.addWidget(browse_btn)

        refresh_btn = QPushButton("🔄 刷新")
        refresh_btn.clicked.connect(self._load_log)
        top.addWidget(refresh_btn)

        layout.addLayout(top)

        # 过滤栏
        filter_bar = QHBoxLayout()

        filter_bar.addWidget(QLabel("级别:"))
        self.level_combo = QComboBox()
        self.level_combo.addItems(["全部", "DEBUG", "INFO", "WARNING", "ERROR"])
        self.level_combo.currentTextChanged.connect(self._apply_filter)
        filter_bar.addWidget(self.level_combo)

        filter_bar.addWidget(QLabel("搜索:"))
        self.search_edit = QLineEdit()
        self.search_edit.setPlaceholderText("关键词...")
        self.search_edit.textChanged.connect(self._apply_filter)
        filter_bar.addWidget(self.search_edit, 1)

        clear_btn = QPushButton("清空过滤")
        clear_btn.clicked.connect(self._clear_filter)
        filter_bar.addWidget(clear_btn)

        layout.addLayout(filter_bar)

        # 日志显示
        self.text_view = QPlainTextEdit()
        self.text_view.setReadOnly(True)
        self.text_view.setFont(QFont("Consolas", 10))
        self.text_view.setLineWrapMode(QPlainTextEdit.NoWrap)
        layout.addWidget(self.text_view, 1)

        # 底部
        bottom = QHBoxLayout()

        self.stats_label = QLabel("")
        self.stats_label.setStyleSheet("color: #888; font-size: 11px;")
        bottom.addWidget(self.stats_label)

        bottom.addStretch()

        copy_btn = QPushButton("📋 复制全部")
        copy_btn.clicked.connect(self._copy_all)
        bottom.addWidget(copy_btn)

        export_btn = QPushButton("📤 导出")
        export_btn.clicked.connect(self._export)
        bottom.addWidget(export_btn)

        close_btn = QPushButton("关闭")
        close_btn.clicked.connect(self.accept)
        bottom.addWidget(close_btn)

        layout.addLayout(bottom)

    def _apply_style(self):
        self.setStyleSheet("""
            QDialog { background-color: #1e1e1e; color: #d4d4d4; }
            QLabel { color: #d4d4d4; }
            QPlainTextEdit {
                background-color: #0d0d0d;
                color: #d4d4d4;
                border: 1px solid #3c3c3c;
                font-family: Consolas, monospace;
            }
            QLineEdit, QComboBox {
                background-color: #3c3c3c;
                color: #d4d4d4;
                border: 1px solid #555;
                border-radius: 3px;
                padding: 4px;
            }
            QPushButton {
                background-color: #0e639c;
                color: white;
                border: none;
                border-radius: 3px;
                padding: 6px 12px;
            }
            QPushButton:hover { background-color: #1177bb; }
        """)

    def _browse(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "选择日志文件", "",
            "日志文件 (*.log);;所有文件 (*.*)"
        )
        if path:
            self.log_path = path
            self.path_edit.setText(path)
            self._load_log()

    def _load_log(self):
        """加载日志"""
        if not self.log_path or not os.path.exists(self.log_path):
            self.text_view.setPlainText("日志文件不存在: " + self.log_path)
            return

        try:
            with open(self.log_path, 'r', encoding='utf-8',
                       errors='replace') as f:
                self._all_lines = f.readlines()
            self._apply_filter()
            self.stats_label.setText("共 %d 行" % len(self._all_lines))
        except Exception as e:
            self.text_view.setPlainText("读取失败: " + str(e))

    def _apply_filter(self):
        """应用过滤"""
        level = self.level_combo.currentText()
        keyword = self.search_edit.text().strip().lower()

        filtered = self._all_lines

        if level != "全部":
            filtered = [l for l in filtered if level in l]

        if keyword:
            filtered = [l for l in filtered if keyword in l.lower()]

        # 限制显示行数
        if len(filtered) > 5000:
            filtered = filtered[-5000:]
            header = "# ... 仅显示最后 5000 行（共 %d 行匹配）\n" % len(filtered)
        else:
            header = ""

        self.text_view.setPlainText(header + "".join(filtered))
        self.stats_label.setText(
            "显示 %d / %d 行" % (len(filtered), len(self._all_lines))
        )

    def _clear_filter(self):
        self.level_combo.setCurrentText("全部")
        self.search_edit.clear()

    def _copy_all(self):
        QApplication.clipboard().setText(self.text_view.toPlainText())
        QMessageBox.information(self, "复制", "已复制到剪贴板")

    def _export(self):
        path, _ = QFileDialog.getSaveFileName(
            self, "导出日志", "log_export.txt", "文本文件 (*.txt)"
        )
        if path:
            try:
                with open(path, 'w', encoding='utf-8') as f:
                    f.write(self.text_view.toPlainText())
                QMessageBox.information(self, "导出", "已导出到: " + path)
            except Exception as e:
                QMessageBox.warning(self, "失败", str(e))