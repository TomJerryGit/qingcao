FILE_SORT_PRIORITY = {
    'dir': 0,
    'file': 1,
}

# 节点类型
NODE_TYPE_DIR = 0
NODE_TYPE_FILE = 1
NODE_TYPE_ROOT = 2


# ============================================================
# 节点类型枚举
# ============================================================
class NodeType(Enum):
    """节点类型"""
    ROOT = auto()
    DIRECTORY = auto()
    FILE = auto()
    SYMLINK = auto()


# ============================================================
# 目录树数据模型
# ============================================================
class DirectoryTreeModel:
    """
    目录树数据模型。

    管理目录树的数据结构，负责:
    - 目录扫描与缓存
    - 路径信息查询
    - 文件过滤
    """

    def __init__(self):
        self.root_path: str = ""
        self.exclude_dirs: Set[str] = set(DEFAULT_EXCLUDE_DIRS)
        self.exclude_patterns: List[str] = []
        self.show_hidden: bool = False
        self.follow_symlinks: bool = False
        self._dir_cache: Dict[str, List[str]] = {}

    # --------------------------------------------------------
    # 根目录
    # --------------------------------------------------------
    def set_root(self, path: str):
        """设置根目录"""
        self.root_path = os.path.abspath(path) if path else ""
        self._dir_cache.clear()

    def get_root(self) -> str:
        """获取根目录"""
        return self.root_path

    # --------------------------------------------------------
    # 目录扫描
    # --------------------------------------------------------
    def list_directory(self, path: str,
                        use_cache: bool = False) -> List[Tuple[str, bool]]:
        """
        列出目录内容。

        参数:
            path: 目录路径
            use_cache: 是否使用缓存

        返回:
            [(名称, 是否目录), ...] 已排序
        """
        if use_cache and path in self._dir_cache:
            return self._dir_cache[path]

        result = []

        try:
            entries = os.listdir(path)
        except (PermissionError, FileNotFoundError, NotADirectoryError):
            return result

        dirs = []
        files = []

        for name in entries:
            # 隐藏文件过滤
            if not self.show_hidden and name.startswith('.'):
                continue

            # 排除目录
            if name in self.exclude_dirs:
                continue

            # 排除模式
            if self._matches_exclude(name):
                continue

            full_path = os.path.join(path, name)

            try:
                is_dir = os.path.isdir(full_path)

                # 符号链接处理
                if os.path.islink(full_path):
                    if not self.follow_symlinks:
                        # 符号链接显示为文件
                        is_dir = False

                if is_dir:
                    dirs.append(name)
                else:
                    files.append(name)

            except OSError:
                continue

        # 排序：目录优先，然后按名称
        dirs.sort(key=str.lower)
        files.sort(key=str.lower)

        for d in dirs:
            result.append((d, True))
        for f in files:
            result.append((f, False))

        if use_cache:
            self._dir_cache[path] = result

        return result

    def _matches_exclude(self, name: str) -> bool:
        """检查是否匹配排除模式"""
        for pattern in self.exclude_patterns:
            if fnmatch.fnmatch(name, pattern):
                return True
        return False

    # --------------------------------------------------------
    # 文件信息
    # --------------------------------------------------------
    def get_file_info(self, path: str) -> Dict[str, Any]:
        """获取文件信息"""
        try:
            stat = os.stat(path)
            return {
                'path': path,
                'name': os.path.basename(path),
                'size': stat.st_size,
                'mtime': stat.st_mtime,
                'ctime': stat.st_ctime,
                'is_dir': os.path.isdir(path),
                'is_file': os.path.isfile(path),
                'is_link': os.path.islink(path),
                'readable': os.access(path, os.R_OK),
                'writable': os.access(path, os.W_OK),
                'executable': os.access(path, os.X_OK),
            }
        except OSError:
            return {}

    def get_relative_path(self, full_path: str) -> str:
        """获取相对于根目录的路径"""
        if not self.root_path:
            return full_path
        try:
            return os.path.relpath(full_path, self.root_path)
        except ValueError:
            return full_path

    def get_depth(self, path: str) -> int:
        """获取路径深度"""
        if not self.root_path:
            return 0
        rel = self.get_relative_path(path)
        if rel == '.':
            return 0
        return rel.count(os.sep) + 1

    # --------------------------------------------------------
    # 清理
    # --------------------------------------------------------
    def clear_cache(self):
        """清空缓存"""
        self._dir_cache.clear()

    def clear_cache_for(self, path: str):
        """清空指定路径的缓存"""
        self._dir_cache.pop(path, None)


# ============================================================
# 目录树面板
# ============================================================
class DirectoryTree(QWidget):
    """
    项目目录树面板。

    功能:
    - 递归展示项目目录
    - 双击打开文件
    - 右键菜单（新建/删除/重命名）
    - 多选批量操作
    - Git 状态着色
    - 文件类型图标
    - 拖放文件
    - 自动刷新
    - 搜索过滤

    信号:
        file_double_clicked(str): 双击文件（文件路径）
        file_opened(str): 打开文件（文件路径）
        directory_changed(str): 目录变更（目录路径）
        selection_changed(list): 选中项变化（路径列表）
        file_created(str): 新文件创建
        file_deleted(str): 文件删除
        file_renamed(str, str): 文件重命名（旧路径, 新路径）
    """

    file_double_clicked = pyqtSignal(str)
    file_opened = pyqtSignal(str)
    directory_changed = pyqtSignal(str)
    selection_changed = pyqtSignal(list)
    file_created = pyqtSignal(str)
    file_deleted = pyqtSignal(str)
    file_renamed = pyqtSignal(str, str)

    def __init__(self, parent=None):
        super().__init__(parent)

        # 数据模型
        self.model = DirectoryTreeModel()

        # 文件系统监听
        self._watcher: Optional[QFileSystemWatcher] = None

        # Git 状态缓存（P1-1 性能优化）
        self._git_root: Optional[str] = None
        self._git_status_cache: Dict[str, str] = {}
        self._git_cache_time: float = 0.0
        self._git_cache_ttl: float = 5.0

        # 图标提供者
        self._icon_provider = QFileIconProvider()

        # 状态
        self._root_item: Optional[QTreeWidgetItem] = None
        self._pending_expansion: Set[str] = set()  # 待展开的路径

        # 自动刷新定时器
        self._refresh_timer = QTimer(self)
        self._refresh_timer.setSingleShot(True)
        self._refresh_timer.setInterval(500)
        self._refresh_timer.timeout.connect(self._do_refresh)

        # UI
        self._build_ui()

        # 连接信号
        self._connect_signals()

    # ========================================================
    # UI 构建
    # ========================================================
    def _build_ui(self):
        """构建 UI"""
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        # 工具条
        toolbar = QWidget()
        toolbar_layout = QHBoxLayout(toolbar)
        toolbar_layout.setContentsMargins(4, 4, 4, 4)
        toolbar_layout.setSpacing(4)

        # 刷新按钮
        self.refresh_btn = QPushButton("🔄")
        self.refresh_btn.setFixedSize(28, 28)
        self.refresh_btn.setToolTip("刷新 (F5)")
        self.refresh_btn.clicked.connect(self.refresh)
        toolbar_layout.addWidget(self.refresh_btn)

        # 折叠全部按钮
        self.collapse_btn = QPushButton("⊟")
        self.collapse_btn.setFixedSize(28, 28)
        self.collapse_btn.setToolTip("折叠全部")
        self.collapse_btn.clicked.connect(self.collapse_all)
        toolbar_layout.addWidget(self.collapse_btn)

        # 显示隐藏文件按钮
        self.hidden_btn = QPushButton("👁")
        self.hidden_btn.setFixedSize(28, 28)
        self.hidden_btn.setCheckable(True)
        self.hidden_btn.setToolTip("显示隐藏文件")
        self.hidden_btn.toggled.connect(self._on_hidden_toggled)
        toolbar_layout.addWidget(self.hidden_btn)

        # 搜索框
        self.search_edit = QLineEdit()
        self.search_edit.setPlaceholderText("搜索文件...")
        self.search_edit.setClearButtonEnabled(True)
        self.search_edit.textChanged.connect(self._on_search_changed)
        toolbar_layout.addWidget(self.search_edit, 1)

        layout.addWidget(toolbar)

        # 目录树
        self.tree = QTreeWidget()
        self.tree.setHeaderHidden(True)
        self.tree.setAnimated(True)
        self.tree.setIndentation(16)
        self.tree.setUniformRowHeights(True)
        self.tree.setSelectionMode(QAbstractItemView.ExtendedSelection)
        self.tree.setContextMenuPolicy(Qt.CustomContextMenu)
        self.tree.setDragEnabled(True)
        self.tree.setAcceptDrops(True)
        self.tree.setDropIndicatorShown(True)
        self.tree.setDragDropMode(QAbstractItemView.DragDrop)
        self.tree.setExpandsOnDoubleClick(False)

        layout.addWidget(self.tree, 1)

        # 状态栏
        self.status_label = QLabel("")
        self.status_label.setObjectName("dir_status_label")
        self.status_label.setFixedHeight(20)
        layout.addWidget(self.status_label)

        # 应用样式
        self._apply_style()

    def _apply_style(self):
        """应用样式"""
        self.setStyleSheet("""
            QTreeWidget {
                background-color: #252526;
                color: #d4d4d4;
                border: none;
                font-size: 12px;
                outline: none;
            }
            QTreeWidget::item {
                padding: 2px 4px;
                border-radius: 3px;
            }
            QTreeWidget::item:hover {
                background-color: #2a2d2e;
            }
            QTreeWidget::item:selected {
                background-color: #094771;
                color: #ffffff;
            }
            QLineEdit {
                background-color: #3c3c3c;
                color: #d4d4d4;
                border: 1px solid #555;
                border-radius: 3px;
                padding: 2px 6px;
                font-size: 12px;
            }
            QLineEdit:focus {
                border-color: #007acc;
            }
            QPushButton {
                background-color: #3c3c3c;
                color: #d4d4d4;
                border: none;
                border-radius: 3px;
                font-size: 14px;
            }
            QPushButton:hover {
                background-color: #4c4c4c;
            }
            QPushButton:checked {
                background-color: #007acc;
                color: white;
            }
            QLabel#dir_status_label {
                background-color: #2d2d2d;
                color: #888;
                font-size: 11px;
                padding: 2px 8px;
            }
        """)

    def _connect_signals(self):
        """连接信号"""
        self.tree.itemDoubleClicked.connect(self._on_item_double_clicked)
        self.tree.itemClicked.connect(self._on_item_clicked)
        self.tree.itemExpanded.connect(self._on_item_expanded)
        self.tree.customContextMenuRequested.connect(self._show_context_menu)
        self.tree.itemSelectionChanged.connect(self._on_selection_changed)

    # ========================================================
    # 根目录设置
    # ========================================================
    def set_root(self, path: str):
        """
        设置项目根目录并构建目录树。

        参数:
            path: 目录路径
        """
        if not path:
            self.clear()
            return

        if not os.path.isdir(path):
            return

        self.model.set_root(path)

        # 清空树
        self.tree.clear()

        # 创建根节点
        root_name = os.path.basename(path) or path
        self._root_item = QTreeWidgetItem(self.tree, [root_name])
        self._root_item.setData(0, Qt.UserRole, path)
        self._root_item.setData(0, Qt.UserRole + 1, NODE_TYPE_ROOT)
        self._root_item.setIcon(0, self._get_folder_icon())

        # 字体加粗
        font = self._root_item.font(0)
        font.setBold(True)
        self._root_item.setFont(0, font)

        # 填充子项
        self._populate_item(self._root_item, path)

        # 展开根节点
        self._root_item.setExpanded(True)

        # 设置文件监听
        self._setup_watcher(path)

        # 更新状态
        self._update_status()

    def clear(self):
        """清空目录树"""
        self.tree.clear()
        self._root_item = None
        self.model.set_root("")
        self._clear_watcher()
        self.status_label.setText("")

    def get_root(self) -> str:
        """获取根目录"""
        return self.model.get_root()

    # ========================================================
    # 目录填充
    # ========================================================
    def _populate_item(self, parent_item: QTreeWidgetItem,
                        dir_path: str, lazy: bool = True):
        """
        填充目录节点的子项。

        参数:
            parent_item: 父节点
            dir_path: 目录路径
            lazy: 是否懒加载（仅加载一层，展开时再加载子目录）
        """
        # 清空现有子项
        for i in range(parent_item.childCount() - 1, -1, -1):
            parent_item.removeChild(parent_item.child(i))

        try:
            entries = self.model.list_directory(dir_path)
        except Exception as e:
            print(f"[DirectoryTree] 读取目录失败: {e}")
            return

        for name, is_dir in entries:
            full_path = os.path.join(dir_path, name)

            item = QTreeWidgetItem(parent_item, [name])
            item.setData(0, Qt.UserRole, full_path)
            item.setData(0, Qt.UserRole + 1,
                         NODE_TYPE_DIR if is_dir else NODE_TYPE_FILE)

            if is_dir:
                item.setIcon(0, self._get_folder_icon())
                # 添加占位子项（用于显示展开箭头）
                if lazy and self._has_subdirs(full_path):
                    placeholder = QTreeWidgetItem(item, ["加载中..."])
                    placeholder.setData(0, Qt.UserRole + 1, -1)
            else:
                item.setIcon(0, self._get_file_icon(full_path))
                # 应用文件类型颜色
                color = self._get_file_type_color(full_path)
                if color:
                    item.setForeground(0, QBrush(color))

            # 应用 Git 状态颜色
            git_status = self._get_git_status(full_path)
            if git_status and git_status in GIT_STATUS_COLORS:
                # 用背景色而非前景色（保留文件类型颜色）
                item.setBackground(0, QBrush(GIT_STATUS_COLORS[git_status]))

    def _has_subdirs(self, dir_path: str) -> bool:
        """检查目录是否有子目录"""
        try:
            for name in os.listdir(dir_path):
                if not self.model.show_hidden and name.startswith('.'):
                    continue
                if name in self.model.exclude_dirs:
                    continue
                full = os.path.join(dir_path, name)
                if os.path.isdir(full):
                    return True
        except (PermissionError, FileNotFoundError):
            pass
        return False

    # ========================================================
    # 图标
    # ========================================================
    def _get_folder_icon(self) -> QIcon:
        """获取文件夹图标"""
        return self._icon_provider.icon(QFileIconProvider.Folder)

    def _get_file_icon(self, filepath: str) -> QIcon:
        """获取文件图标"""
        try:
            info = QFileInfo(filepath)
            return self._icon_provider.icon(info)
        except Exception:
            return self._icon_provider.icon(QFileIconProvider.File)

    def _get_file_type_color(self, filepath: str) -> Optional[QColor]:
        """获取文件类型颜色"""
        ext = os.path.splitext(filepath)[1].lower()
        return FILE_TYPE_COLORS.get(ext)

    # ========================================================
    # Git 状态
    # ========================================================
    def _get_git_status(self, filepath: str) -> str:
        """
        获取文件的 Git 状态（带缓存）。

        修复说明（P1-1）:
            原实现对每个文件独立调用 `git status`，
            一个包含 N 个文件的目录会启动 N 个 git 子进程。
            现改为一次性获取整个仓库状态并缓存 5 秒。
        """
        try:
            git_root = self._find_git_root(filepath)
            if not git_root:
                return ''

            now = time.time()
            if (self._git_root == git_root and
                    now - self._git_cache_time < self._git_cache_ttl):
                return self._lookup_git_status(filepath, git_root)

            self._git_root = git_root
            self._git_status_cache = self._fetch_git_status(git_root)
            self._git_cache_time = now

            return self._lookup_git_status(filepath, git_root)
        except Exception:
            return ''

    def _find_git_root(self, filepath: str) -> Optional[str]:
        """查找文件的 git 根目录"""
        try:
            dirpath = (os.path.dirname(filepath)
                       if os.path.isfile(filepath) else filepath)
            check_path = os.path.abspath(dirpath)
            while check_path != os.path.dirname(check_path):
                if os.path.isdir(os.path.join(check_path, '.git')):
                    return check_path
                check_path = os.path.dirname(check_path)
        except Exception:
            pass
        return None

    def _fetch_git_status(self, git_root: str) -> Dict[str, str]:
        """一次性获取整个 git 仓库的状态"""
        try:
            result = subprocess.run(
                ['git', '-C', git_root, 'status', '--porcelain'],
                capture_output=True, text=True, timeout=5,
                encoding='utf-8', errors='replace'
            )
            if result.returncode != 0:
                return {}

            status_map: Dict[str, str] = {}
            for line in result.stdout.splitlines():
                if len(line) < 4:
                    continue
                status = line[:2]
                path = line[3:].strip()
                if ' -> ' in path:
                    path = path.split(' -> ')[-1]
                abs_path = os.path.normpath(
                    os.path.join(git_root, path)
                ).replace('\\', '/')
                if len(status) >= 2:
                    if status[1] != ' ':
                        status_map[abs_path] = status[1]
                    elif status[0] != ' ':
                        status_map[abs_path] = status[0]
            return status_map
        except (subprocess.TimeoutExpired, FileNotFoundError):
            return {}
        except Exception:
            return {}

    def _lookup_git_status(self, filepath: str, git_root: str) -> str:
        """从缓存查询指定文件的 Git 状态"""
        try:
            abs_path = os.path.normpath(filepath).replace('\\', '/')
            return self._git_status_cache.get(abs_path, '')
        except Exception:
            return ''

    def refresh_git_status(self):
        """刷新所有节点的 Git 状态"""
        def _refresh_recursive(item: QTreeWidgetItem):
            path = item.data(0, Qt.UserRole)
            if path:
                git_status = self._get_git_status(path)
                if git_status and git_status in GIT_STATUS_COLORS:
                    item.setBackground(0, QBrush(GIT_STATUS_COLORS[git_status]))
                else:
                    item.setBackground(0, QBrush())

            for i in range(item.childCount()):
                child = item.child(i)
                if child.data(0, Qt.UserRole + 1) != -1:  # 非占位符
                    _refresh_recursive(child)

        if self._root_item:
            _refresh_recursive(self._root_item)

    # ========================================================
    # 文件系统监听
    # ========================================================
    def _setup_watcher(self, root_path: str):
        """设置文件系统监听"""
        self._clear_watcher()

        self._watcher = QFileSystemWatcher(self)
        self._add_watch_recursive(root_path)

        self._watcher.directoryChanged.connect(self._on_directory_changed)
        self._watcher.fileChanged.connect(self._on_file_changed)

    def _clear_watcher(self):
        """清空监听器"""
        if self._watcher:
            try:
                dirs = self._watcher.directories()
                files = self._watcher.files()
                if dirs:
                    self._watcher.removePaths(dirs)
                if files:
                    self._watcher.removePaths(files)
            except Exception:
                pass
            self._watcher = None

    def _add_watch_recursive(self, path: str, max_depth: int = 3,
                              current_depth: int = 0):
        """递归添加监听（限制深度防止过度消耗）"""
        if current_depth > max_depth:
            return

        if not self._watcher or not os.path.isdir(path):
            return

        try:
            if path not in self._watcher.directories():
                self._watcher.addPath(path)
        except Exception:
            return

        if current_depth >= max_depth:
            return

        try:
            for name in os.listdir(path):
                if not self.model.show_hidden and name.startswith('.'):
                    continue
                if name in self.model.exclude_dirs:
                    continue

                full_path = os.path.join(path, name)
                if os.path.isdir(full_path) and not os.path.islink(full_path):
                    self._add_watch_recursive(full_path, max_depth,
                                               current_depth + 1)
        except (PermissionError, FileNotFoundError):
            pass

    def _on_directory_changed(self, path: str):
        """目录变化回调"""
        # 延迟刷新
        self._refresh_timer.start()
        self.directory_changed.emit(path)

    def _on_file_changed(self, path: str):
        """文件变化回调"""
        # 更新对应节点
        item = self._find_item_by_path(path)
        if item:
            # 更新文件大小等属性
            pass

    def _do_refresh(self):
        """执行刷新"""
        if not self._root_item:
            return

        root_path = self._root_item.data(0, Qt.UserRole)
        if not root_path or not os.path.isdir(root_path):
            return

        # 保存展开状态
        expanded_paths = self._get_expanded_paths()

        # 清空缓存
        self.model.clear_cache()

        # 重新填充
        self._populate_item(self._root_item, root_path)

        # 恢复展开状态
        self._restore_expanded_paths(expanded_paths)

        # 更新状态
        self._update_status()

    def refresh(self):
        """手动刷新"""
        self._do_refresh()

    def _get_expanded_paths(self) -> Set[str]:
        """获取所有展开的节点路径"""
        expanded = set()

        def _collect(item):
            if item.isExpanded():
                path = item.data(0, Qt.UserRole)
                if path:
                    expanded.add(path)
            for i in range(item.childCount()):
                child = item.child(i)
                if child.data(0, Qt.UserRole + 1) != -1:
                    _collect(child)

        if self._root_item:
            _collect(self._root_item)

        return expanded

    def _restore_expanded_paths(self, paths: Set[str]):
        """恢复展开状态"""
        def _restore(item):
            path = item.data(0, Qt.UserRole)
            if path in paths:
                self._ensure_expanded(item)
            for i in range(item.childCount()):
                child = item.child(i)
                if child.data(0, Qt.UserRole + 1) != -1:
                    _restore(child)

        if self._root_item:
            _restore(self._root_item)

    # ========================================================
    # 展开与折叠
    # ========================================================
    def _on_item_expanded(self, item: QTreeWidgetItem):
        """节点展开回调（懒加载子目录）"""
        # 检查是否为占位符
        if item.childCount() == 1:
            child = item.child(0)
            if child.data(0, Qt.UserRole + 1) == -1:
                # 移除占位符，加载真实子项
                item.removeChild(child)
                path = item.data(0, Qt.UserRole)
                if path:
                    self._populate_item(item, path, lazy=True)

    def _ensure_expanded(self, item: QTreeWidgetItem):
        """确保节点展开（触发懒加载）"""
        if not item.isExpanded():
            item.setExpanded(True)
        # 手动触发子项加载
        self._on_item_expanded(item)

    def collapse_all(self):
        """折叠所有节点"""
        if self._root_item:
            self.tree.collapseItem(self._root_item)
            self._root_item.setExpanded(True)  # 根节点保持展开

    def expand_all(self, max_depth: int = 3):
        """展开所有节点（限制深度）"""
        def _expand(item, depth):
            if depth > max_depth:
                return
            self._ensure_expanded(item)
            for i in range(item.childCount()):
                child = item.child(i)
                if child.data(0, Qt.UserRole + 1) == NODE_TYPE_DIR:
                    _expand(child, depth + 1)

        if self._root_item:
            _expand(self._root_item, 0)

    # ========================================================
    # 交互
    # ========================================================
    def _on_item_double_clicked(self, item: QTreeWidgetItem, column: int):
        """双击节点"""
        path = item.data(0, Qt.UserRole)
        if not path:
            return

        node_type = item.data(0, Qt.UserRole + 1)

        if node_type == NODE_TYPE_DIR or node_type == NODE_TYPE_ROOT:
            # 切换展开状态
            item.setExpanded(not item.isExpanded())
            if item.isExpanded():
                self._on_item_expanded(item)
        else:
            # 打开文件
            self.file_double_clicked.emit(path)
            self.file_opened.emit(path)

    def _on_item_clicked(self, item: QTreeWidgetItem, column: int):
        """单击节点"""
        path = item.data(0, Qt.UserRole)
        if path:
            self._update_status_path(path)

    def _on_selection_changed(self):
        """选中项变化"""
        selected_paths = self.get_selected_paths()
        self.selection_changed.emit(selected_paths)
        self._update_status()

    def _on_hidden_toggled(self, checked: bool):
        """切换显示隐藏文件"""
        self.model.show_hidden = checked
        self._do_refresh()

    def _on_search_changed(self, text: str):
        """搜索框变化"""
        text = text.strip()
        if not text:
            # 清空搜索，显示全部
            self._show_all_items()
            return

        self._filter_items(text)

    def _show_all_items(self):
        """显示所有项"""
        def _show(item):
            item.setHidden(False)
            for i in range(item.childCount()):
                _show(item.child(i))

        if self._root_item:
            _show(self._root_item)

    def _filter_items(self, text: str):
        """根据搜索词过滤项"""
        text = text.lower()

        def _filter(item) -> bool:
            """返回 True 表示该项或其子孙匹配"""
            path = item.data(0, Qt.UserRole) or ""
            name = os.path.basename(path).lower()

            # 当前项是否匹配
            self_match = text in name

            # 子孙是否匹配
            any_child_match = False
            for i in range(item.childCount()):
                child = item.child(i)
                if child.data(0, Qt.UserRole + 1) == -1:
                    continue
                if _filter(child):
                    any_child_match = True

            visible = self_match or any_child_match
            item.setHidden(not visible)

            # 展开匹配项
            if any_child_match and not item.isExpanded():
                item.setExpanded(True)
                self._on_item_expanded(item)

            return visible

        if self._root_item:
            _filter(self._root_item)

    # ========================================================
    # 上下文菜单
    # ========================================================
    def _show_context_menu(self, pos):
        """显示右键菜单"""
        item = self.tree.itemAt(pos)
        if item is None:
            # 点击空白区域
            self._show_blank_context_menu(pos)
            return

        path = item.data(0, Qt.UserRole)
        node_type = item.data(0, Qt.UserRole + 1)

        if not path:
            return

        menu = QMenu(self)

        # 针对文件的菜单
        if node_type == NODE_TYPE_FILE:
            open_act = menu.addAction("📂 打开")
            open_act.triggered.connect(
                lambda: self._open_file(path)
            )

            open_system_act = menu.addAction("🌐 用系统默认程序打开")
            open_system_act.triggered.connect(
                lambda: self._open_with_system(path)
            )

            menu.addSeparator()

            reveal_act = menu.addAction("📁 在文件管理器中显示")
            reveal_act.triggered.connect(
                lambda: self._reveal_in_explorer(path)
            )

            copy_path_act = menu.addAction("📋 复制完整路径")
            copy_path_act.triggered.connect(
                lambda: self._copy_to_clipboard(path)
            )

            copy_rel_act = menu.addAction("📋 复制相对路径")
            copy_rel_act.triggered.connect(
                lambda: self._copy_relative_path(path)
            )

            copy_name_act = menu.addAction("📋 复制文件名")
            copy_name_act.triggered.connect(
                lambda: self._copy_to_clipboard(os.path.basename(path))
            )

            menu.addSeparator()

        # 针对目录的菜单
        if node_type in (NODE_TYPE_DIR, NODE_TYPE_ROOT):
            new_file_act = menu.addAction("📄 新建文件")
            new_file_act.triggered.connect(
                lambda: self._create_file(path)
            )

            new_folder_act = menu.addAction("📁 新建文件夹")
            new_folder_act.triggered.connect(
                lambda: self._create_folder(path)
            )

            menu.addSeparator()

            refresh_act = menu.addAction("🔄 刷新")
            refresh_act.triggered.connect(self._do_refresh)

            # 仅对根目录提供关闭项目
            if node_type == NODE_TYPE_ROOT:
                menu.addSeparator()
                close_act = menu.addAction("❌ 关闭项目")
                close_act.triggered.connect(self.clear)

            menu.addSeparator()

        # 重命名和删除（仅对非根节点）
        if node_type != NODE_TYPE_ROOT:
            rename_act = menu.addAction("✏ 重命名")
            rename_act.triggered.connect(
                lambda: self._rename_item(item)
            )

            delete_act = menu.addAction("🗑 删除")
            delete_act.triggered.connect(
                lambda: self._delete_item(item)
            )

            menu.addSeparator()

        # 多选时批量操作
        selected = self.tree.selectedItems()
        if len(selected) > 1:
            batch_delete_act = menu.addAction(f"🗑 批量删除 ({len(selected)} 项)")
            batch_delete_act.triggered.connect(
                lambda: self._batch_delete(selected)
            )

            menu.addSeparator()

        # 属性
        properties_act = menu.addAction("ℹ 属性")
        properties_act.triggered.connect(
            lambda: self._show_properties(path)
        )

        # 显示菜单
        menu.exec(self.tree.viewport().mapToGlobal(pos))

    def _show_blank_context_menu(self, pos):
        """点击空白区域的上下文菜单"""
        menu = QMenu(self)

        refresh_act = menu.addAction("🔄 刷新")
        refresh_act.triggered.connect(self._do_refresh)

        if self._root_item:
            expand_act = menu.addAction("⊞ 展开全部")
            expand_act.triggered.connect(lambda: self.expand_all(3))

            collapse_act = menu.addAction("⊟ 折叠全部")
            collapse_act.triggered.connect(self.collapse_all)

        menu.exec(self.tree.viewport().mapToGlobal(pos))

    # ========================================================
    # 文件操作
    # ========================================================
    def _create_file(self, parent_dir: str):
        """新建文件"""
        name, ok = QInputDialog.getText(
            self, "新建文件", "文件名:",
            text="new_file.txt"
        )

        if not ok or not name:
            return

        # 清理文件名
        name = name.strip()
        if not name:
            return

        full_path = os.path.join(parent_dir, name)

        if os.path.exists(full_path):
            QMessageBox.warning(self, "文件已存在",
                                 f"文件已存在: {name}")
            return

        try:
            # 确保目录存在
            os.makedirs(os.path.dirname(full_path), exist_ok=True)

            # 创建空文件
            with open(full_path, 'w', encoding='utf-8') as f:
                pass

            # 刷新目录
            self._do_refresh()

            # 定位到新文件
            self._select_path(full_path)

            # 发射信号
            self.file_created.emit(full_path)

            # 可选：自动打开新文件
            self.file_opened.emit(full_path)

        except Exception as e:
            QMessageBox.critical(self, "创建失败", str(e))

    def _create_folder(self, parent_dir: str):
        """新建文件夹"""
        name, ok = QInputDialog.getText(
            self, "新建文件夹", "文件夹名:",
            text="new_folder"
        )

        if not ok or not name:
            return

        name = name.strip()
        if not name:
            return

        full_path = os.path.join(parent_dir, name)

        if os.path.exists(full_path):
            QMessageBox.warning(self, "文件夹已存在",
                                 f"文件夹已存在: {name}")
            return

        try:
            os.makedirs(full_path)
            self._do_refresh()
            self._select_path(full_path)
        except Exception as e:
            QMessageBox.critical(self, "创建失败", str(e))

    def _rename_item(self, item: QTreeWidgetItem):
        """重命名节点"""
        old_path = item.data(0, Qt.UserRole)
        if not old_path:
            return

        old_name = os.path.basename(old_path)

        new_name, ok = QInputDialog.getText(
            self, "重命名", "新名称:", text=old_name
        )

        if not ok or not new_name:
            return

        new_name = new_name.strip()
        if not new_name or new_name == old_name:
            return

        new_path = os.path.join(os.path.dirname(old_path), new_name)

        if os.path.exists(new_path):
            QMessageBox.warning(self, "名称冲突",
                                 f"目标已存在: {new_name}")
            return

        try:
            os.rename(old_path, new_path)

            # 更新模型缓存
            self.model.clear_cache()

            # 刷新
            self._do_refresh()

            # 定位到新文件
            self._select_path(new_path)

            # 发射信号
            self.file_renamed.emit(old_path, new_path)

        except Exception as e:
            QMessageBox.critical(self, "重命名失败", str(e))

    def _delete_item(self, item: QTreeWidgetItem):
        """删除节点"""
        path = item.data(0, Qt.UserRole)
        if not path:
            return

        name = os.path.basename(path)
        is_dir = os.path.isdir(path)

        # 确认对话框
        type_name = "文件夹" if is_dir else "文件"
        msg = f"确定要删除{type_name}吗？\n\n{name}"

        if is_dir:
            # 检查是否为空
            try:
                children = os.listdir(path)
                if children:
                    msg += f"\n\n⚠ 该文件夹包含 {len(children)} 项内容，将一并删除！"
            except Exception:
                pass

        reply = QMessageBox.question(
            self, "确认删除", msg,
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )

        if reply != QMessageBox.Yes:
            return

        try:
            if is_dir:
                shutil.rmtree(path)
            else:
                os.remove(path)

            # 刷新
            self._do_refresh()

            # 发射信号
            self.file_deleted.emit(path)

        except Exception as e:
            QMessageBox.critical(self, "删除失败", str(e))

    def _batch_delete(self, items: List[QTreeWidgetItem]):
        """批量删除"""
        paths = []
        for item in items:
            path = item.data(0, Qt.UserRole)
            if path and path not in paths:
                paths.append(path)

        if not paths:
            return

        # 检查是否有子路径被包含
        filtered_paths = []
        for path in paths:
            is_child = False
            for other in paths:
                if path != other and path.startswith(other + os.sep):
                    is_child = True
                    break
            if not is_child:
                filtered_paths.append(path)

        paths = filtered_paths

        # 确认
        msg = f"确定要删除以下 {len(paths)} 项吗？\n\n"
        msg += "\n".join(f"• {os.path.basename(p)}" for p in paths[:10])
        if len(paths) > 10:
            msg += f"\n... 及其他 {len(paths) - 10} 项"
        msg += "\n\n此操作不可撤销！"

        reply = QMessageBox.question(
            self, "批量删除", msg,
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )

        if reply != QMessageBox.Yes:
            return

        # 执行删除
        deleted = 0
        errors = []
        for path in paths:
            try:
                if os.path.isdir(path):
                    shutil.rmtree(path)
                else:
                    os.remove(path)
                deleted += 1
                self.file_deleted.emit(path)
            except Exception as e:
                errors.append(f"{os.path.basename(path)}: {e}")

        # 刷新
        self._do_refresh()

        # 提示结果
        if errors:
            QMessageBox.warning(
                self, "部分删除失败",
                f"成功删除 {deleted} 项，{len(errors)} 项失败:\n\n"
                + "\n".join(errors[:5])
            )

    # ========================================================
    # 辅助操作
    # ========================================================
    def _open_file(self, path: str):
        """打开文件"""
        self.file_opened.emit(path)

    def _open_with_system(self, path: str):
        """用系统默认程序打开"""
        try:
            if sys.platform == 'win32':
                os.startfile(path)
            elif sys.platform == 'darwin':
                subprocess.Popen(['open', path])
            else:
                subprocess.Popen(['xdg-open', path])
        except Exception as e:
            QMessageBox.warning(self, "打开失败", str(e))

    def _reveal_in_explorer(self, path: str):
        """在文件管理器中显示"""
        try:
            if sys.platform == 'win32':
                subprocess.Popen(['explorer', '/select,',
                                   path.replace('/', '\\')])
            elif sys.platform == 'darwin':
                subprocess.Popen(['open', '-R', path])
            else:
                folder = os.path.dirname(path) if os.path.isfile(path) else path
                subprocess.Popen(['xdg-open', folder])
        except Exception as e:
            QMessageBox.warning(self, "无法打开", str(e))

    def _copy_to_clipboard(self, text: str):
        """复制到剪贴板"""
        try:
            QApplication.clipboard().setText(text)
            self._show_status(f"已复制: {text[:50]}", 2000)
        except Exception:
            pass

    def _copy_relative_path(self, path: str):
        """复制相对路径"""
        rel = self.model.get_relative_path(path)
        self._copy_to_clipboard(rel)

    def _show_properties(self, path: str):
        """显示文件属性"""
        info = self.model.get_file_info(path)
        if not info:
            return

        size = info.get('size', 0)
        size_str = self._format_size(size)

        mtime = info.get('mtime', 0)
        mtime_str = time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(mtime))

        is_dir = info.get('is_dir', False)
        type_str = "文件夹" if is_dir else "文件"

        msg = f"""<h3>{os.path.basename(path)}</h3>
<p><b>类型:</b> {type_str}</p>
<p><b>路径:</b> {path}</p>
<p><b>大小:</b> {size_str}</p>
<p><b>修改时间:</b> {mtime_str}</p>
<p><b>可读:</b> {'是' if info.get('readable') else '否'}</p>
<p><b>可写:</b> {'是' if info.get('writable') else '否'}</p>
<p><b>可执行:</b> {'是' if info.get('executable') else '否'}</p>
"""

        QMessageBox.information(self, "属性", msg)

    @staticmethod
    def _format_size(size: int) -> str:
        """格式化文件大小"""
        if size < 1024:
            return f"{size} 字节"
        elif size < 1024 * 1024:
            return f"{size / 1024:.1f} KB"
        elif size < 1024 * 1024 * 1024:
            return f"{size / 1024 / 1024:.1f} MB"
        else:
            return f"{size / 1024 / 1024 / 1024:.2f} GB"

    # ========================================================
    # 定位与选择
    # ========================================================
    def _find_item_by_path(self, path: str) -> Optional[QTreeWidgetItem]:
        """根据路径查找节点"""
        if not self._root_item:
            return None

        path = os.path.normpath(path)

        def _search(item):
            item_path = item.data(0, Qt.UserRole)
            if item_path and os.path.normpath(item_path) == path:
                return item

            # 确保子项已加载
            if item.data(0, Qt.UserRole + 1) in (NODE_TYPE_DIR, NODE_TYPE_ROOT):
                if item.childCount() == 1:
                    child = item.child(0)
                    if child.data(0, Qt.UserRole + 1) == -1:
                        self._on_item_expanded(item)

            for i in range(item.childCount()):
                child = item.child(i)
                if child.data(0, Qt.UserRole + 1) == -1:
                    continue
                result = _search(child)
                if result:
                    return result
            return None

        return _search(self._root_item)

    def _select_path(self, path: str):
        """选中指定路径的节点"""
        item = self._find_item_by_path(path)
        if item:
            # 展开所有父节点
            parent = item.parent()
            while parent:
                parent.setExpanded(True)
                self._on_item_expanded(parent)
                parent = parent.parent()

            # 选中
            self.tree.setCurrentItem(item)
            self.tree.scrollToItem(item)

    def _update_status(self):
        """更新状态栏"""
        if not self._root_item:
            self.status_label.setText("")
            return

        # 统计
        total_dirs = 0
        total_files = 0

        def _count(item):
            nonlocal total_dirs, total_files
            node_type = item.data(0, Qt.UserRole + 1)
            if node_type == NODE_TYPE_DIR:
                total_dirs += 1
            elif node_type == NODE_TYPE_FILE:
                total_files += 1

            for i in range(item.childCount()):
                child = item.child(i)
                if child.data(0, Qt.UserRole + 1) != -1:
                    _count(child)

        _count(self._root_item)

        selected_count = len(self.tree.selectedItems())
        if selected_count > 0:
            self.status_label.setText(
                f"已选中 {selected_count} 项 · 共 {total_dirs} 目录, {total_files} 文件"
            )
        else:
            self.status_label.setText(
                f"{total_dirs} 目录, {total_files} 文件"
            )

    def _update_status_path(self, path: str):
        """更新状态栏显示路径"""
        rel = self.model.get_relative_path(path)
        self.status_label.setText(rel)

    def _show_status(self, message: str, timeout: int = 3000):
        """显示状态消息"""
        try:
            from app.event_bus import bus, StatusMessageEvent
            bus.emit_event(StatusMessageEvent(
                message=message, timeout=timeout
            ))
        except Exception:
            pass

    # ========================================================
    # 查询
    # ========================================================
    def get_selected_paths(self) -> List[str]:
        """获取所有选中项的路径"""
        paths = []
        for item in self.tree.selectedItems():
            path = item.data(0, Qt.UserRole)
            if path:
                paths.append(path)
        return paths

    def get_current_path(self) -> Optional[str]:
        """获取当前选中项路径"""
        item = self.tree.currentItem()
        if item:
            return item.data(0, Qt.UserRole)
        return None

    def set_exclude_dirs(self, dirs: List[str]):
        """设置排除目录"""
        self.model.exclude_dirs = set(dirs)
        self._do_refresh()

    def set_exclude_patterns(self, patterns: List[str]):
        """设置排除模式"""
        self.model.exclude_patterns = list(patterns)
        self._do_refresh()

    # ========================================================
    # 拖放支持
    # ========================================================
    def dragEnterEvent(self, event):
        """拖入事件"""
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event):
        """放下事件"""
        if not event.mimeData().hasUrls():
            return

        # 获取目标目录
        item = self.tree.itemAt(event.pos())
        target_dir = self.model.get_root()

        if item:
            path = item.data(0, Qt.UserRole)
            if path:
                target_dir = path if os.path.isdir(path) else os.path.dirname(path)

        if not target_dir or not os.path.isdir(target_dir):
            return

        # 复制文件
        for url in event.mimeData().urls():
            if not url.isLocalFile():
                continue

            source = url.toLocalFile()
            if not os.path.exists(source):
                continue

            try:
                dest = os.path.join(target_dir, os.path.basename(source))
                if os.path.exists(dest):
                    continue

                if os.path.isdir(source):
                    shutil.copytree(source, dest)
                else:
                    shutil.copy2(source, dest)
            except Exception as e:
                print(f"[DirectoryTree] 拖放失败: {e}")

        self._do_refresh()

    # ========================================================
    # 调试
    # ========================================================
    def dump(self) -> str:
        """导出目录树信息"""
        lines = ["DirectoryTree", "=" * 60]
        lines.append(f"根目录: {self.model.get_root()}")
        lines.append(f"显示隐藏: {self.model.show_hidden}")
        lines.append(f"排除目录数: {len(self.model.exclude_dirs)}")
        lines.append(f"排除模式数: {len(self.model.exclude_patterns)}")

        if self._root_item:
            lines.append("")
            lines.append("目录树:")
            self._dump_item(self._root_item, lines, 0)

        return "\n".join(lines)

    def _dump_item(self, item: QTreeWidgetItem, lines: List[str],
                    depth: int, max_depth: int = 3):
        """递归导出节点"""
        if depth > max_depth:
            return

        indent = "  " * depth
        name = item.text(0)
        node_type = item.data(0, Qt.UserRole + 1)

        type_marker = {
            NODE_TYPE_ROOT: "📁",
            NODE_TYPE_DIR: "📂",
            NODE_TYPE_FILE: "📄",
        }.get(node_type, "?")

        lines.append(f"{indent}{type_marker} {name}")

        for i in range(item.childCount()):
            child = item.child(i)
            if child.data(0, Qt.UserRole + 1) != -1:
                self._dump_item(child, lines, depth + 1, max_depth)

    def __repr__(self) -> str:
        return (f"<DirectoryTree root={self.model.get_root()!r} "
                f"items={self.tree.topLevelItemCount()}>")


# ============================================================
# 模块测试
# ============================================================
if __name__ == "__main__":
    import tempfile
    from PyQt5.QtWidgets import QApplication, QMainWindow

    app = QApplication(sys.argv)

    # 创建测试目录结构
    tmp_dir = tempfile.mkdtemp(prefix="qingcao_dirtree_test_")

    # 创建文件和目录
    os.makedirs(os.path.join(tmp_dir, "src"))
    os.makedirs(os.path.join(tmp_dir, "tests"))
    os.makedirs(os.path.join(tmp_dir, "docs"))
    os.makedirs(os.path.join(tmp_dir, "src", "utils"))

    test_files = [
        ("main.py", "#!/usr/bin/env python\n"),
        ("README.md", "# Test Project\n"),
        ("src/__init__.py", ""),
        ("src/app.py", "def main():\n    pass\n"),
        ("src/utils/__init__.py", ""),
        ("src/utils/helper.py", "def helper():\n    pass\n"),
        ("tests/test_main.py", "def test():\n    pass\n"),
        ("docs/guide.md", "# Guide\n"),
        (".gitignore", "*.pyc\n__pycache__/\n"),
        ("config.json", '{"key": "value"}\n'),
    ]

    for rel_path, content in test_files:
        full_path = os.path.join(tmp_dir, rel_path)
        os.makedirs(os.path.dirname(full_path), exist_ok=True)
        with open(full_path, 'w', encoding='utf-8') as f:
            f.write(content)

    # 创建主窗口
    win = QMainWindow()
    win.setWindowTitle("DirectoryTree 测试")
    win.resize(400, 700)

    # 创建目录树
    tree = DirectoryTree()
    win.setCentralWidget(tree)
    win.show()

    # 设置根目录
    tree.set_root(tmp_dir)

    print("=== DirectoryTree 测试 ===")
    print(tree.dump())
    print()

    # 连接信号
    tree.file_double_clicked.connect(
        lambda p: print(f"[信号] 双击文件: {p}")
    )
    tree.file_created.connect(
        lambda p: print(f"[信号] 文件创建: {p}")
    )
    tree.file_deleted.connect(
        lambda p: print(f"[信号] 文件删除: {p}")
    )
    tree.file_renamed.connect(
        lambda old, new: print(f"[信号] 重命名: {old} -> {new}")
    )
    tree.selection_changed.connect(
        lambda paths: print(f"[信号] 选中: {len(paths)} 项")
    )

    # 定时退出
    def cleanup_and_quit():
        shutil.rmtree(tmp_dir, ignore_errors=True)
        app.quit()

    QTimer.singleShot(8000, cleanup_and_quit)

    sys.exit(app.exec())